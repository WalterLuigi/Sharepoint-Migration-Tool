<Window x:Class="SharePointMigrationTool.OperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="600" Width="800"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,10"/>

        <!-- Preview Section -->
        <GroupBox Grid.Row="1" Header="Files to be Affected" Margin="0,0,0,10" Visibility="{Binding PreviewVisibility}">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Folders: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FolderCount}" Foreground="#D13438" Margin="0,0,15,0"/>
                    <TextBlock Text="Files: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FileCount}" Foreground="#0078D4"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding SampleFiles}"
                         BorderBrush="#CCCCCC" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Output Log -->
        <GroupBox Grid.Row="2" Header="Output" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log Action Buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearLogCommand}" Padding="10,4" Margin="0,0,5,0" FontSize="11"/>
                    <Button Content="Export..." Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportLogCommand}" Padding="10,4" FontSize="11"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Background="#1E1E1E">
                    <TextBox Text="{Binding OutputLog}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="Transparent"
                             Foreground="#FFFFFF"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             VerticalAlignment="Top"
                             Padding="5"/>
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Proceed" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ProceedCommand}" Visibility="{Binding ProceedVisibility}"
                    IsEnabled="{Binding CanProceed}" Padding="20,8" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource DangerButton}"
                    Command="{Binding CancelCommand}" Visibility="{Binding ProceedVisibility}"
                    Padding="20,8" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#666666"/>
            <Button Grid.Column="3" Content="Close" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CloseCommand}" Visibility="{Binding CloseVisibility}"
                    Padding="20,8"/>
        </Grid>
    </Grid>
</Window>