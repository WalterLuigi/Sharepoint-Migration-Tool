<Window x:Class="SharePointMigrationTool.PrerequisitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SharePoint Migration Tool - Prerequisites"
        Height="500" Width="550"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Closed="Window_Closed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Checking Prerequisites" FontSize="18" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,15"/>

        <!-- Status List -->
        <GroupBox Grid.Row="1" Header="Requirements" Padding="10">
            <StackPanel>
                <!-- PowerShell 7 -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="PowerShell 7" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="PowerShellStatus" Text="Checking..." VerticalAlignment="Center" Margin="10,0" Foreground="#666666"/>
                    <Button Grid.Column="2" x:Name="InstallPowerShellBtn" Content="Download" Visibility="Collapsed" Padding="10,5" Click="InstallPowerShell_Click"/>
                </Grid>

                <Separator Margin="0,10"/>

                <!-- PnP PowerShell -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="PnP PowerShell Module" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="PnPStatus" Text="Checking..." VerticalAlignment="Center" Margin="10,0" Foreground="#666666"/>
                    <Button Grid.Column="2" x:Name="InstallPnPBtn" Content="Install" Visibility="Collapsed" Padding="10,5" Click="InstallPnP_Click"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Output Log -->
        <GroupBox Grid.Row="2" Header="Installation Log" Margin="0,10,0,0" Padding="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Background="#1E1E1E">
                <TextBox x:Name="OutputLog" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12" Background="Transparent"
                         Foreground="#FFFFFF" BorderThickness="0" Padding="5"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="ContinueBtn" Content="Continue" Style="{StaticResource PrimaryButton}"
                    Padding="20,8" Margin="0,0,10,0" Click="Continue_Click" IsEnabled="False"/>
            <Button Content="Exit" Style="{StaticResource SecondaryButton}"
                    Padding="20,8" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>