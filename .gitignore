# === SENSITIVE — Never commit these ===

# Configuration files with real credentials
config/migration-config.json
PowerShell/config/migration-config.json
**/migration-config.json
!**/migration-config.template.json

# Certificate files (private keys — NEVER commit)
certs/
PowerShell/certs/
**/*.pfx
**/*.pem
**/*.cer
**/*.crt
**/*.key
**/*.p12

# Claude Code local settings (may contain personal paths)
.claude/

# Encrypted password blobs and secrets
**/secrets.json
**/appsettings.local.json

# === END SENSITIVE ===

