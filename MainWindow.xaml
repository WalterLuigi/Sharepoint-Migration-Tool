<Window x:Class="SharePointMigrationTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SharePointMigrationTool.ViewModels"
        Title="SharePoint Tenant-to-Tenant Migration Tool"
        Height="800" Width="1000"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="SharePoint Migration Tool" FontSize="24" FontWeight="Bold" Foreground="#0078D4"/>
            <TextBlock Text="Migrate files and folders between SharePoint tenants" FontSize="13" Foreground="#666666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Source Tenant Setup -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Source Tenant" Margin="0,0,5,5">
                <StackPanel Margin="10">
                    <Label Content="Tenant ID (e.g., source.onmicrosoft.com)"/>
                    <TextBox Text="{Binding Config.SourceTenant.TenantId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                    <Label Content="App ID (Application Client ID)"/>
                    <TextBox Text="{Binding Config.SourceTenant.AppId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                    <Label Content="Thumbprint (Certificate Thumbprint)"/>
                    <TextBox Text="{Binding Config.SourceTenant.Thumbprint, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Register App" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RegisterSourceAppCommand}" IsEnabled="{Binding IsNotRunning}"
                                Margin="0,0,10,0"/>
                        <Button Content="Remove" Style="{StaticResource DangerButton}"
                                Command="{Binding RemoveSourceAppCommand}" IsEnabled="{Binding IsNotRunning}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Target Tenant Setup -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="Target Tenant" Margin="5,0,0,5">
                <StackPanel Margin="10">
                    <Label Content="Tenant ID (e.g., target.onmicrosoft.com)"/>
                    <TextBox Text="{Binding Config.TargetTenant.TenantId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                    <Label Content="App ID (Application Client ID)"/>
                    <TextBox Text="{Binding Config.TargetTenant.AppId, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                    <Label Content="Thumbprint (Certificate Thumbprint)"/>
                    <TextBox Text="{Binding Config.TargetTenant.Thumbprint, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Register App" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RegisterTargetAppCommand}" IsEnabled="{Binding IsNotRunning}"
                                Margin="0,0,10,0"/>
                        <Button Content="Remove" Style="{StaticResource DangerButton}"
                                Command="{Binding RemoveTargetAppCommand}" IsEnabled="{Binding IsNotRunning}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Site Configuration -->
            <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Site Configuration" Margin="0,5,0,5">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="Source Site URL"/>
                        <TextBox Text="{Binding Config.Migration.SourceSiteUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                        <Label Content="Target Site URL"/>
                        <TextBox Text="{Binding Config.Migration.TargetSiteUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                        <Label Content="Library Name"/>
                        <TextBox Text="{Binding Config.Migration.LibraryName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" IsEnabled="{Binding IsNotRunning}"/>

                        <Button Content="Save Configuration" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SaveConfigCommand}" IsEnabled="{Binding IsNotRunning}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Label Content="Actions"/>
                        <Button Content="Test Connection" Style="{StaticResource SecondaryButton}"
                                Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsNotRunning}"
                                Margin="0,0,0,10" Padding="30,8"/>

                        <GroupBox Header="Migration" Margin="0,10,0,0">
                            <StackPanel Margin="5">
                                <Button Content="Ghostbuster (Check In)" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding GhostbusterCommand}" IsEnabled="{Binding IsSetupComplete}"
                                        Margin="0,5" Padding="30,8"/>
                                <Button Content="Dry Run (Preview)" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DryRunCommand}" IsEnabled="{Binding IsSetupComplete}"
                                        Margin="0,5" Padding="30,8"/>
                                <Button Content="Start Migration" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding StartMigrationCommand}" IsEnabled="{Binding IsSetupComplete}"
                                        Margin="0,5" Padding="30,8"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Terminal Output -->
        <GroupBox Grid.Row="2" Header="Output" Margin="0,10,0,0">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Log Action Buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearLogCommand}" Padding="10,4" Margin="0,0,5,0" FontSize="11"/>
                    <Button Content="Export..." Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportLogCommand}" Padding="10,4" FontSize="11"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              Background="#1E1E1E">
                    <TextBox x:Name="OutputTextBox"
                             Text="{Binding OutputLog}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="Transparent"
                             Foreground="#FFFFFF"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             VerticalAlignment="Top"
                             Padding="5"/>
                </ScrollViewer>

                <StatusBar Grid.Row="2" Background="#F5F5F5" Margin="0,5,0,0">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusMessage}"/>
                    </StatusBarItem>
                    <Separator/>
                    <StatusBarItem>
                        <TextBlock Text="{Binding SetupStatus}"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </GroupBox>
    </Grid>
</Window>